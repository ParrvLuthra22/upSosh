generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  host
  admin
}

enum HostStatus {
  none
  pending
  verified
}

enum EventStatus {
  draft
  live
  full
  past
  cancelled
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  refunded
  expired // unpaid for >15 minutes — see the sweep in index.ts
}

// "failed" was missing from the old free-text column — there was no way to
// represent a payment that Razorpay reported as failed; the row just stayed
// "unpaid" forever, indistinguishable from a checkout that was never
// attempted.
enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

enum PaymentMethod {
  razorpay
  upi
  free
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  username             String     @unique
  // Optional — a Google-only account (googleId set, no password ever chosen)
  // has no local password to hash. auth.ts's password-based /signin route
  // must check for this before bcrypt.compare(), which throws on a
  // non-string hash instead of just failing the comparison.
  password             String?
  // Set on first Google sign-in for this email, whether that creates a new
  // account or links to an existing password account with a matching email.
  googleId             String?    @unique
  name                 String
  photoUrl             String?
  bio                  String?
  role                 Role       @default(user)
  hostStatus           HostStatus @default(none)
  onboardingComplete   Boolean    @default(false)

  // Onboarding data
  interests            String     @default("[]") // JSON array
  city                 String?
  groupSize            String?    // "intimate" | "larger"
  vibe                 String?    // "chill" | "structured"
  frequency            String?    // "weekly" | "occasional"
  wantsToHost          Boolean    @default(false)

  // Host profile
  hostBio              String?
  hostExperience       String?    // "first" | "few" | "experienced"
  hostCategories       String     @default("[]") // JSON array
  hostInstagram        String?
  hostLinkedin         String?
  hostWebsite          String?

  // Password reset
  resetToken           String?
  resetTokenExpiry     DateTime?

  // Soft delete — set by DELETE /api/users/me. The row is kept (not
  // hard-deleted) so existing Bookings/Events/HostApplications retain a
  // valid userId; email/name/PII are anonymized at the same time.
  deletedAt            DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events               Event[]
  bookings             Booking[]
  hostApplication      HostApplication?
  uploads              Upload[]
  notifications        Notification[]

  @@index([resetToken])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'booking' | 'event' | 'host' | 'verification' | 'general' — matches the
  // frontend's Notification type in components/layout/GlobalHeader.tsx.
  // Not a Prisma enum: this list is UI copy, not a schema-level invariant,
  // and a plain string means adding a new notification type is a
  // frontend-and-route change, not a migration.
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Host {
  id       String  @id @default(cuid())
  name     String
  verified Boolean @default(false)
  avatar   String
  events   Event[]
}

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique @default(cuid())
  type        String
  category    String      @default("General")
  date        DateTime
  time        String
  venue       String
  city        String      @default("Delhi")
  price       Float
  isFree      Boolean     @default(false)
  description String
  image       String
  tags        String      @default("[]") // JSON array
  capacity    Int         @default(30)
  attendees   Int         @default(0)
  status      EventStatus @default(draft)
  isSuperhost Boolean     @default(false)

  hostId      String?
  host        Host?       @relation(fields: [hostId], references: [id])
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])

  bookings    Booking[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, date])
  @@index([city])
  @@index([category])
  @@index([userId])
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id])

  guestName     String        @default("")
  guestEmail    String        @default("")
  guestPhone    String        @default("")
  notes         String?

  ticketPrice   Float         @default(0)
  platformFee   Float         @default(25)
  totalAmount   Float
  currency      String        @default("INR")

  status        BookingStatus @default(pending)
  paymentStatus PaymentStatus @default(unpaid)
  paymentId     String?
  paymentMethod PaymentMethod?

  // Binds a Razorpay order to this specific booking. Without it, /verify cannot
  // tell whether a valid {order_id, payment_id, signature} triple belongs here,
  // so one cheap payment could be replayed to confirm any number of bookings.
  // @unique already gives this an index — no separate @@index needed.
  razorpayOrderId String?     @unique
  paidAt          DateTime?
  refundId        String?

  qrCode        String?       // ticket QR data
  checkedIn     Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt])
}

model HostApplication {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])

  govIdUrl        String?
  selfieUrl       String?
  bio             String
  experience      String
  categories      String    @default("[]") // JSON
  instagram       String?
  linkedin        String?
  website         String?

  sampleEventTitle    String?
  sampleEventCategory String?
  sampleEventDesc     String?
  sampleEventDate     DateTime?
  sampleEventTime     String?
  sampleEventVenue    String?
  sampleEventCity     String?
  sampleEventCapacity Int?
  sampleEventIsFree   Boolean @default(true)
  sampleEventPrice    Float?

  status          String    @default("pending") // "pending" | "approved" | "rejected"
  reviewedAt      DateTime?
  reviewNotes     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
