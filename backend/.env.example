# Server Configuration
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upsosh?schema=public"

# Authentication
JWT_SECRET="your-super-secure-jwt-secret-key-change-this"

# Google Sign-In (Identity Services ID-token flow — only a Client ID is
# needed here, never a client secret; POST /api/auth/google verifies the
# token's signature against Google's own public keys). Create one at
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Add every origin that
# serves the frontend (http://localhost:3000, your production domain(s)) to
# "Authorized JavaScript origins" — no redirect URI needed for this flow.
# Must be the same value as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Leave unset to disable Google sign-in (POST /api/auth/google 503s; the
# frontend's "Continue with Google" button doesn't render at all).
GOOGLE_CLIENT_ID=""

# Payment Integration (Razorpay)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# *** REQUIRED for webhooks to work at all — not optional ***
# Dashboard: Settings -> Webhooks -> your webhook -> Secret. Must match the
# secret configured on the Razorpay side for POST /api/payments/webhook's URL.
# POST /api/payments/webhook now fails CLOSED if this is unset (returns 500 to
# Razorpay, verifies nothing) rather than the old behavior of skipping
# signature verification entirely when it was missing.
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# AI Feature Integration (OpenRouter — get your key at openrouter.ai)
OPENROUTER_API_KEY="sk-or-your-key-here"

# Email (Resend — get your key at resend.com)
RESEND_API_KEY="re_your_key_here"

# Image uploads (Cloudinary — get credentials at cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
