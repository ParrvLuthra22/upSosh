# ─────────────────────────────────────────────────────────────────────────────
# upSosh frontend — environment variables
#
# Copy to .env for local development:   cp .env.example .env
#
# Everything here is prefixed NEXT_PUBLIC_, which means Next.js inlines it into
# the browser bundle at build time. Never put a secret in this file — anything
# here is readable by anyone who opens devtools. Server-side secrets (JWT,
# Razorpay key SECRET, database URL) belong in backend/.env only.
#
# NOTE: these are read at BUILD time, not runtime. Changing one means rebuilding
# and redeploying the frontend, not just restarting it.
# ─────────────────────────────────────────────────────────────────────────────


# ── API location ─────────────────────────────────────────────────────────────
# Leave BOTH of these empty for local dev. next.config.js rewrites /api/* to
# NEXT_PUBLIC_BACKEND_URL (defaulting to http://localhost:4000), so requests are
# same-origin and cookies just work.
#
# In production set them to your deployed backend.

# Base URL that client code prefixes onto /api/* calls.
# Local dev: leave empty (the rewrite proxy handles it).
# Production: https://your-backend.up.railway.app/api
NEXT_PUBLIC_API_URL=

# Origin of the Express backend, used by the next.config.js rewrite and by a few
# pages that build their own absolute URLs.
# Local dev: http://localhost:4000
# Production: https://your-backend.up.railway.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public origin of this frontend. Used for absolute links and by Playwright's
# baseURL. Local dev: http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000


# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# *** REQUIRED — DO NOT LEAVE THIS BLANK ***
#
# This is the publishable key id (safe in the browser). The matching secret goes
# in backend/.env as RAZORPAY_KEY_SECRET and must never appear here.
#
# WHY IT MATTERS: if this variable is missing, the booking flow does not error —
# it silently SKIPS payment entirely and jumps straight to the confirmation
# screen, so every paid booking is created for free with paymentStatus 'unpaid'.
# See frontend/lib/stores/booking.ts (the demo-mode branch). Until that branch is
# removed, an empty value here is a revenue hole, not a warning.
#
# Get a test key: dashboard.razorpay.com → Settings → API Keys.
# Test keys start with rzp_test_ and only accept test cards.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx


# ── Social sign-in (optional) ────────────────────────────────────────────────

# Google sign-in — OPTIONAL. When set, /signin and /signup render Google's
# "Continue with Google" button (components/GoogleSignInButton.tsx) and
# backend/src/routes/auth.ts's POST /api/auth/google verifies the resulting
# ID token. Leaving this blank just means the button doesn't render — no
# broken UI either way.
#
# This is the public Client ID (safe in the browser) — must be the exact
# same value as backend/.env's GOOGLE_CLIENT_ID. No client secret is needed
# on the frontend or backend for this flow.
#
# Create one: console.cloud.google.com → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application. Add every origin
# that serves the frontend (http://localhost:3000, your production
# domain(s)) under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Sign In — NOT implemented. This variable is currently unused by any
# component; kept here as a placeholder for if that's ever built.
NEXT_PUBLIC_APPLE_CLIENT_ID=
